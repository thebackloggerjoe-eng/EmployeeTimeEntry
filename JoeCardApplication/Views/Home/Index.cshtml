    <section class="offer-container">
        <div class="offer-left">
            <p class="entryLabel">CREDIT CONFIDENCE STARTS HERE</p>
            <div class="entryLargeText">Respond to your Joe Financial<sup>®</sup> Credit Card offer</div>
            <p class="description">
                Enter a few details below to get started. The application takes a couple of minutes and
                you'll get a decision as soon as you complete it.
            </p>

            <div class="inputCell nameCell">
                <label for="certNumber">
                    Acceptance Certificate Number
                </label>
                <div class="input-group input-group-soft w-100 mb-2">
                    <input class="form-control alphaNumericOnly" data-val="true" data-val-regex="You must enter a valid Acceptance Certificate Number." data-val-required="Please enter a valid Acceptance Certificate Number." id="solicitationNum" maxlength="12" name="solicitationNum" type="text" value="">
                </div>
               <!-- <div class="small-link t-2">
                    <a href="/Lookup/Lookup02">Can't find your Acceptance Certificate Number?</a>
                </div> -->
                <span class="text-danger d-block mb-1 mt-3 field-validation-valid" data-valmsg-for="solicitationNum" data-valmsg-replace="true"></span>
                <label for="lastName">
                    Last Name
                </label>
                <div class="input-group input-group-soft w-100 mb-3">
                    <input class="form-control alphaOnly" data-val="true" data-val-required="Please enter your last name exactly as it appears on your offer letter." id="lastName" maxlength="25" minlength="2" name="lastName" type="text" value="">
                </div>
            <span class="text-danger d-block mt-1 field-validation-valid" data-valmsg-for="lastName" data-valmsg-replace="true"></span>
                <div style="height: 10px;"></div>
                <label for="emailAddress">
                    Email Address (Optional)
                </label>

                <div class="input-group input-group-soft w-100 mb-2">
                    <input class="form-control" data-val="true" data-val-regex="Please enter a valid email address" id="CertificateEmail" name="CertificateEmail" style="height:40px" type="text" value="">
                    </div>
            <span class="text-danger d-block mt-3 field-validation-valid" data-valmsg-for="CertificateEmail" data-valmsg-replace="true"></span>
                <div class="entryButtonContainer mt-1">
                    <input id="entryButtonSubmit" type="submit" value="Unlock your offer" class="entryButton" formaction="/Home/SubmitCertificate">
                </div>
            </div>
        </div>

       <!-- <div class="offer-right">
            <img src="../content/images/threeCardEntry.png" alt="Credit cards" class="cards-img">
        </div>-->
    </section>
