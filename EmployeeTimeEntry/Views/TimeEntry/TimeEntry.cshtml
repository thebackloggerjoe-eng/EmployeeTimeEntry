@model EmployeeTimeEntry.Models.EmployeeTimeEntryModel

@{
    ViewBag.Title = "Time Entry";
}

@using (Html.BeginForm("TimeEntry", "TimeEntry", FormMethod.Post, new { id = "timeEntryForm", @class = "needs-validated" }))
{
    <div class="container">
        <!-- Modal -->
        <div class="modal fade" id="timeEntry">
            <!-- tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true"> -->
            <div class="modal-dialog modal-lg" role="document" style="max-width: 300px">
                <div class="modal-content">
                    <div class="modal-header">
                        close
                        <button type="button" id="btnTimeEntryClose" class="close" data-dismiss="timeEntry">
                            x
                        </button>
                    </div>
                    <h4 class="modal-title">Time Entry Form</h4>
                    <div class="form-control" style="border-top: 0">
                        <div class="form-Field">
                            <span id="timeExistsError" class="text-danger" style="display:none">@ViewBag.TimeExistsMesssage</span>
                            @Html.DropDownListFor(m => m.EmployeeID, Model.NamesList, "-- Select Employee --", new { @class = "form-select" })
                            <span id="empValidDisplay" style="display:none">@Html.ValidationMessageFor(m => m.EmployeeID, "", new { @class = "text-danger" })</span>

                        </div>

                        <div class="form-Field">
                            @Html.LabelFor(m => m.Date)
                            @Html.TextBoxFor(m => m.Date, "{0:d MMM yyyy}", new { @class = "form-control", type = "date" })
                            <!--@Html.ValidationMessageFor(m => m.Date, "", new { @class = "text-danger" })-->
                            <span id="dateError" class="text-danger" style="display:none">Please Enter a Valid Date</span>
                        </div>

                        <div class="form-Field">
                            @Html.LabelFor(m => m.InTime)
                            @Html.TextBoxFor(m => m.InTime, "{0:HH:mm}", new { @class = "form-control", type = "time" })
                            <!-- @Html.ValidationMessageFor(m => m.InTime, "", new { @class = "text-danger" })-->
                            <span id="inTimeError" class="text-danger" style="display:none">Please Enter a Valid In Time</span>
                        </div>

                        <div class="form-Field">
                            @Html.LabelFor(m => m.OutTime)
                            @Html.TextBoxFor(m => m.OutTime, "{0:HH:mm}", new { @class = "form-control", type = "time" })
                            <!--@Html.ValidationMessageFor(m => m.OutTime, "", new { @class = "text-danger" })-->
                            <span id="outTimeError" class="text-danger" style="display:none">Please Enter a Valid Out Time</span>
                            <span id="timeDifError" class="text-danger" style="display:none">@ViewBag.timeDifferenceOff</span>
                        </div>

                        <button id="addTimeBtn" type="button" class="btn btn-primary" onclick="checkValidation()">Add Time</button>

                        @Html.TextBoxFor(m => m.EntryID, new { style = "display: none;" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>

        <!-- <div style="display: flex;display: flex;justify-content: center;">-->
        <h1>Employee Time Entry</h1>

        <!-- Button trigger modal -->
        <div class="entry-and-sort">
            <button type="button" id="btnTimeEntry">
                New Time Entry
            </button>

            @Html.DropDownListFor(model => model.SelectedFilter, Model.FilterList, "-- filter by --", new { @class = "form-select", onchange = "this.form.submit();" })
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Employee Full Name:</th>
                    <th>Date:</th>
                    <th>In Time:</th>
                    <th>Out Time:</th>
                    <th>Total hours:</th>
                </tr>


            </thead>

            <tbody>
                @foreach (var emp in ViewData["employeeList"] as List<EmployeeTimeEntryModel>)
                {
                    <tr>
                        <td>@emp.FirstName @emp.LastName</td>
                        <td>@emp.Date.ToShortDateString()</td>
                        <td>@emp.InTime.TimeOfDay.ToString().Remove(@emp.InTime.TimeOfDay.ToString().Length - 3)</td>
                        <td>@emp.OutTime.TimeOfDay.ToString().Remove(@emp.OutTime.TimeOfDay.ToString().Length - 3)</td>
                        <td>@emp.TotalHours</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
}

@section Scripts {
    <!--<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>-->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js"></script>
    <script src="bootstrap/js/bootstrap.min.js"></script>

    <script type="text/javascript">
        $(function () {
            if ('@ViewBag.TimeExistsMesssage'.length > 0)
            {
                $("#timeExistsError").show();
                $("#timeEntry").modal('show');
            }

            if ('@ViewBag.timeDifferenceOff'.length > 0)
            {
                $("#timeDifError").show();
                $("#timeEntry").modal('show');
            }
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $("#btnTimeEntry").click(function () {
                $("#timeEntry").modal('show');
                // alert("clicked");
            });

            $("#btnTimeEntryClose").click(function () {
                $("#timeEntry").modal('hide');
            });
        });

        function checkValidation()
        {
            const dateEntry = Date.parse($('#Date').val());

            const regex_time = /^(\d{2}):(\d{2})$/;

            const inTimeMatches = $('#InTime').val().match(regex_time);
            const outTimeMatches = $('#OutTime').val().match(regex_time);
 
            $("#empValidDisplay").hide();
            $("#dateError").hide();

            if ($('#EmployeeID').val() == '')
            {
                $("#empValidDisplay").show();
            }

            if (isNaN(dateEntry))
            {
                $("#dateError").show();
            }

            if (!inTimeMatches)
            {
                $("#inTimeError").show();
            }

            if (!outTimeMatches)
            {
                $("#outTimeError").show();
            }

            if ($('#EmployeeID').val() == '' || isNaN(dateEntry)) { return; }

            $('#timeEntryForm').submit();
        }

    </script>
}




