@model EmployeeTimeEntry.Models.EmployeeTimeEntryModel

@{
    ViewBag.Title = "Time Entry";
}

@using (Html.BeginForm("TimeEntry", "TimeEntry", FormMethod.Post))
{
  
    @Html.LabelFor(model => model.SelectedNameId, "Select an Employee:")

    <div class="mb-3">
        <label class="form-label">Select Employee</label>
        <select class="form-select" asp-items="Model.NamesList">

        </select>
    </div>

    <input type="submit" name="nameSort" value="myValue"/>

    
}


<div>
   <!-- <div style="display: flex;display: flex;justify-content: center;">-->
    <h1>Employee Time Entry</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name:</th>
                <th>Date:</th>
                <th>In Time:</th>
                <th>Out Time:</th>
                <th>Total hours:</th>
            </tr>


        </thead>

        <tbody>
            @foreach (var emp in ViewData["employeeList"] as List<EmployeeTimeEntryModel>)
            {
                <tr>
                    <td>@emp.FirstName @emp.LastName</td>
                    <td>@emp.Date.ToShortDateString()</td>
                    <td>@emp.InTime.TimeOfDay</td>
                    <td>@emp.OutTime.TimeOfDay</td>
                    <td>0</td>
                </tr>
            }

        </tbody>

    </table>
    


</div>

